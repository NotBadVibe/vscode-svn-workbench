{
  "name": "svn-workbench",
  "displayName": "SVN \u5de5\u4f5c\u53f0",
  "description": "\u9762\u5411\u4e2d\u6587\u7528\u6237\u7684 AI \u539f\u751f SVN \u5de5\u4f5c\u53f0\u3002",
  "version": "0.0.11",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "author": "NotBadVibe",
  "repository": {
    "type": "git",
    "url": "https://github.com/NotBadVibe/vscode-svn-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/NotBadVibe/vscode-svn-workbench/issues"
  },
  "homepage": "https://github.com/NotBadVibe/vscode-svn-workbench#readme",
  "packageManager": "npm@12.0.2",
  "keywords": [
    "svn",
    "subversion",
    "ai",
    "scm"
  ],
  "engines": {
    "vscode": "^1.92.0",
    "node": ">=26.0.0 <27",
    "npm": ">=12.0.2 <13"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.svn",
    "onCommand:svnWorkbench.openWorkbench",
    "onCommand:svnWorkbench.checkEnvironment",
    "onCommand:svnWorkbench.refreshStatus",
    "onCommand:svnWorkbench.updateScope",
    "onCommand:svnWorkbench.openProperties",
    "onCommand:svnWorkbench.openCleanup",
    "onCommand:svnWorkbench.openRepositoryBrowser",
    "onCommand:svnWorkbench.createBranch",
    "onCommand:svnWorkbench.createTag",
    "onCommand:svnWorkbench.switchWorkingCopy",
    "onCommand:svnWorkbench.relocateWorkingCopy",
    "onCommand:svnWorkbench.mergeToWorkingCopy",
    "onCommand:svnWorkbench.openPatchShelf",
    "onCommand:svnWorkbench.openReleaseNotes",
    "onCommand:svnWorkbench.commitFolder",
    "onCommand:svnWorkbench.openConflictCenter",
    "onCommand:svnWorkbench.openDiff",
    "onCommand:svnWorkbench.openHistory",
    "onCommand:svnWorkbench.openTeamConfig",
    "onCommand:svnWorkbench.configureTeamConfig",
    "onCommand:svnWorkbench.showOutput",
    "onCommand:svnWorkbench.aiConfigure",
    "onCommand:svnWorkbench.aiTestConnection",
    "onCommand:svnWorkbench.aiSelectScope",
    "onCommand:svnWorkbench.aiReviewScope",
    "onCommand:svnWorkbench.analyzeImpact",
    "onCommand:svnWorkbench.openChangelists",
    "onCommand:svnWorkbench.openAgent",
    "onCommand:svnWorkbench.openAcceptanceChecklist",
    "onCommand:svnWorkbench.openProjects"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SVN \u5de5\u4f5c\u53f0",
      "properties": {
        "svnWorkbench.svn.path": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "svn \u53ef\u6267\u884c\u6587\u4ef6\u8def\u5f84\u3002\u7559\u7a7a\u65f6\u81ea\u52a8\u641c\u7d22 PATH \u548c\u5404\u5e73\u53f0\u5e38\u89c1\u5b89\u88c5\u4f4d\u7f6e\u3002"
        },
        "svnWorkbench.diff.openMode": {
          "type": "string",
          "default": "sameGroup",
          "enum": [
            "sameGroup",
            "beside"
          ],
          "enumDescriptions": [
            "\u5728\u5f53\u524d\u7f16\u8f91\u7ec4\u4e2d\u6fc0\u6d3b SVN Diff \u6807\u7b7e\u3002",
            "\u5728\u5f53\u524d\u7f16\u8f91\u7ec4\u65c1\u65b0\u5efa\u7ec4\u5e76\u6fc0\u6d3b SVN Diff \u6807\u7b7e\u3002"
          ],
          "markdownDescription": "\u5dee\u5f02\u7a97\u53e3\u6253\u5f00\u4f4d\u7f6e\u3002`sameGroup` \u9ed8\u8ba4\u590d\u7528\u5f53\u524d\u7f16\u8f91\u7ec4\uff1b`beside` \u4fdd\u7559\u5e76\u6392\u67e5\u770b\u4e60\u60ef\u3002"
        },
        "svnWorkbench.ai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI \u517c\u5bb9 API Base URL\u3002\u5efa\u8bae\u901a\u8fc7\u201cSVN\uff1aAI \u914d\u7f6e\u6a21\u578b\u201d\u914d\u7f6e\u3002"
        },
        "svnWorkbench.ai.providerPreset": {
          "type": "string",
          "default": "deepseek",
          "enum": [
            "deepseek",
            "qwenDashscope",
            "zhipuCoding",
            "zhipuGeneral",
            "kimi",
            "custom"
          ],
          "description": "AI \u670d\u52a1\u5546\u9884\u8bbe\u3002\u9884\u8bbe\u53ea\u662f\u53ef\u7f16\u8f91\u6a21\u677f\uff0c\u63a5\u53e3\u5730\u5740\u548c\u6a21\u578b\u4ecd\u53ef\u81ea\u884c\u4fee\u6539\u3002"
        },
        "svnWorkbench.ai.model": {
          "type": "string",
          "default": "",
          "description": "OpenAI \u517c\u5bb9\u670d\u52a1\u4f7f\u7528\u7684\u9ed8\u8ba4\u6a21\u578b\u540d\u79f0\u3002"
        },
        "svnWorkbench.ai.scenarioModels": {
          "type": "object",
          "default": {},
          "properties": {
            "commitSelection": {
              "type": "string",
              "description": "\u53ef\u9009\uff1a\u5355\u72ec\u6307\u5b9a AI \u63d0\u4ea4\u6587\u4ef6\u9009\u62e9\u6a21\u578b\u3002"
            },
            "conflictAdvice": {
              "type": "string",
              "description": "\u53ef\u9009\uff1a\u5355\u72ec\u6307\u5b9a AI \u51b2\u7a81\u5efa\u8bae\u6a21\u578b\u3002"
            },
            "commitMessage": {
              "type": "string",
              "description": "\u53ef\u9009\uff1a\u5355\u72ec\u6307\u5b9a AI \u63d0\u4ea4\u8bf4\u660e\u751f\u6210\u6a21\u578b\u3002"
            },
            "commitSplit": {
              "type": "string",
              "description": "\u53ef\u9009\uff1a\u5355\u72ec\u6307\u5b9a AI \u63d0\u4ea4\u62c6\u5206\u5efa\u8bae\u6a21\u578b\u3002"
            },
            "teamRules": {
              "type": "string",
              "description": "\u53ef\u9009\uff1a\u5355\u72ec\u6307\u5b9a AI \u56e2\u961f\u89c4\u5219\u63a8\u8350\u6a21\u578b\u3002"
            },
            "conflictMerge": {
              "type": "string",
              "description": "\u53ef\u9009\uff1a\u5355\u72ec\u6307\u5b9a AI \u51b2\u7a81\u5408\u5e76\u5019\u9009\u751f\u6210\u6a21\u578b\u3002"
            }
          },
          "description": "\u6309\u5de5\u4f5c\u53f0\u4f7f\u7528\u573a\u666f\u8986\u76d6 AI \u6a21\u578b\uff1b\u7559\u7a7a\u65f6\u7ee7\u627f\u9ed8\u8ba4\u6a21\u578b\u8bbe\u7f6e\u3002"
        },
        "svnWorkbench.ai.includeCommitHistory": {
          "type": "boolean",
          "default": false,
          "description": "\u5141\u8bb8\u751f\u6210\u63d0\u4ea4\u8bf4\u660e\u65f6\u4f7f\u7528\u5df2\u8131\u654f\u7684\u672c\u5730\u6210\u529f\u63d0\u4ea4\u6458\u8981\u3002"
        },
        "svnWorkbench.ai.historyLimit": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 20,
          "description": "\u542f\u7528\u5386\u53f2\u540e\u6700\u591a\u4f7f\u7528\u7684\u8131\u654f\u63d0\u4ea4\u6458\u8981\u6761\u6570\u3002"
        },
        "svnWorkbench.commitConvention.enabled": {
          "type": "boolean",
          "default": false,
          "description": "\u5728 SVN \u63d0\u4ea4\u524d\u542f\u7528\u56e2\u961f\u63d0\u4ea4\u8bf4\u660e\u89c4\u8303\u68c0\u67e5\u3002"
        },
        "svnWorkbench.commitConvention.requiredIssueId": {
          "type": "boolean",
          "default": false,
          "description": "\u542f\u7528\u63d0\u4ea4\u89c4\u8303\u540e\uff0c\u8981\u6c42\u63d0\u4ea4\u8bf4\u660e\u5305\u542b\u4efb\u52a1\u7f16\u53f7\u3002"
        },
        "svnWorkbench.commitConvention.issueIdPattern": {
          "type": "string",
          "default": "[A-Z]+-\\d+|#\\d+",
          "description": "\u7528\u4e8e\u6821\u9a8c\u63d0\u4ea4\u8bf4\u660e\u4e2d\u4efb\u52a1\u7f16\u53f7\u7684\u6b63\u5219\u8868\u8fbe\u5f0f\u3002"
        },
        "svnWorkbench.commitConvention.requiredModule": {
          "type": "boolean",
          "default": false,
          "description": "\u8981\u6c42\u63d0\u4ea4\u8bf4\u660e\u9996\u884c\u5305\u542b\u6a21\u5757\uff0c\u4f8b\u5982 feat(order): message\u3002"
        },
        "svnWorkbench.commitConvention.allowedModules": {
          "type": "array",
          "default": [
            "order",
            "user",
            "config",
            "docs"
          ],
          "items": {
            "type": "string"
          },
          "description": "\u63d0\u4ea4\u8bf4\u660e\u9996\u884c\u5141\u8bb8\u4f7f\u7528\u7684\u6a21\u5757\u540d\u79f0\u3002"
        },
        "svnWorkbench.commitConvention.requiredPrefix": {
          "type": "boolean",
          "default": false,
          "description": "\u8981\u6c42\u63d0\u4ea4\u8bf4\u660e\u9996\u884c\u4f7f\u7528\u7ea6\u5b9a\u524d\u7f00\u3002"
        },
        "svnWorkbench.commitConvention.allowedPrefixes": {
          "type": "array",
          "default": [
            "feat",
            "fix",
            "config",
            "docs",
            "refactor",
            "test",
            "chore"
          ],
          "items": {
            "type": "string"
          },
          "description": "\u63d0\u4ea4\u8bf4\u660e\u9996\u884c\u5141\u8bb8\u4f7f\u7528\u7684\u7ea6\u5b9a\u524d\u7f00\u3002"
        },
        "svnWorkbench.commitSelection.statusRules": {
          "type": "object",
          "default": {},
          "properties": {
            "modified": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "modified \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "added": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "added \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "deleted": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "deleted \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "replaced": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "replaced \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "propertyModified": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "\u4ec5 SVN \u5c5e\u6027\u53d8\u5316\uff08status=normal \u4e14 propStatus=modified\uff09\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "missing": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "missing \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "unversioned": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "unversioned \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "unknown": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "unknown \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\u3002"
            },
            "normal": {
              "type": "string",
              "enum": [
                "recommended",
                "needsReview",
                "excluded"
              ],
              "description": "normal \u72b6\u6001\u7684\u9ed8\u8ba4\u51b3\u7b56\uff1b\u4e0d\u5f71\u54cd\u4ec5\u5c5e\u6027\u53d8\u5316\u7684\u5224\u65ad\u3002"
            }
          },
          "description": "\u63d0\u4ea4\u6587\u4ef6\u9009\u62e9\u7684 SVN \u72b6\u6001\u9ed8\u8ba4\u7b56\u7565\u3002\u51b3\u7b56\u503c\uff1arecommended\uff08\u63a8\u8350\u63d0\u4ea4\uff09\u3001needsReview\uff08\u9700\u8981\u786e\u8ba4\uff09\u3001excluded\uff08\u6392\u9664\uff09\u3002ignored\u3001external\u3001conflicted\u3001obstructed\u3001incomplete \u4e3a\u5b89\u5168\u72b6\u6001\uff0c\u4e0d\u53ef\u914d\u7f6e\u3002\u4ed3\u5e93\u7ea7\u89c4\u5219\u89c1 .svn-workbench.json \u7684 commitSelection \u952e\u3002"
        },
        "svnWorkbench.commitSelection.pathRules": {
          "type": "array",
          "default": [],
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "id",
              "pattern",
              "decision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
                "description": "\u7a33\u5b9a\u89c4\u5219 ID\uff1b\u4e0e\u5185\u7f6e\u89c4\u5219\u540c ID \u65f6\u8986\u76d6\u5185\u7f6e\u5b9a\u4e49\u3002"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "\u662f\u5426\u542f\u7528\u8be5\u89c4\u5219\u3002"
              },
              "pattern": {
                "type": "string",
                "maxLength": 200,
                "description": "Glob \u8def\u5f84\u8868\u8fbe\u5f0f\uff1a\u76f8\u5bf9\u4ed3\u5e93\u6839\u3001\u7edf\u4e00 / \u5206\u9694\u3001\u652f\u6301 **\u3002"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "recommended",
                  "needsReview",
                  "excluded"
                ],
                "description": "\u547d\u4e2d\u540e\u7684\u51b3\u7b56\uff1arecommended\uff08\u63a8\u8350\u63d0\u4ea4\uff09\u3001needsReview\uff08\u9700\u8981\u786e\u8ba4\uff09\u3001excluded\uff08\u6392\u9664\uff09\u3002"
              },
              "reason": {
                "type": "string",
                "default": "",
                "description": "\u8be5\u89c4\u5219\u7684\u4e2d\u6587\u539f\u56e0\u8bf4\u660e\u3002"
              },
              "caseSensitive": {
                "type": "boolean",
                "default": true,
                "description": "\u5339\u914d\u662f\u5426\u5927\u5c0f\u5199\u654f\u611f\u3002"
              }
            }
          },
          "description": "\u63d0\u4ea4\u6587\u4ef6\u9009\u62e9\u7684 Glob \u8def\u5f84\u89c4\u5219\uff0c\u7b2c\u4e00\u6761\u547d\u4e2d\u751f\u6548\uff0c\u4f18\u5148\u7ea7\u9ad8\u4e8e\u72b6\u6001\u9ed8\u8ba4\u7b56\u7565\uff1b\u81ea\u5b9a\u4e49\u89c4\u5219\u6309\u987a\u5e8f\u5728\u5185\u7f6e\u89c4\u5219\u4e4b\u524d\u8bc4\u4f30\u3002blocked \u51b3\u7b56\u4e0d\u53ef\u914d\u7f6e\u3002\u4ed3\u5e93\u7ea7\u89c4\u5219\u89c1 .svn-workbench.json \u7684 commitSelection \u952e\u3002"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".svn-workbench.json",
        "url": "./schemas/svn-workbench.schema.json"
      }
    ],
    "commands": [
      {
        "command": "svnWorkbench.openWorkbench",
        "title": "SVN\uff1a\u67e5\u770b\u5de5\u4f5c\u526f\u672c\u4fee\u6539"
      },
      {
        "command": "svnWorkbench.checkEnvironment",
        "title": "SVN\uff1a\u68c0\u67e5\u73af\u5883"
      },
      {
        "command": "svnWorkbench.refreshStatus",
        "title": "SVN\uff1a\u5237\u65b0\u72b6\u6001"
      },
      {
        "command": "svnWorkbench.updateScope",
        "title": "SVN\uff1a\u66f4\u65b0\u5f53\u524d\u8303\u56f4"
      },
      {
        "command": "svnWorkbench.openProperties",
        "title": "SVN\uff1a\u67e5\u770b\u4e0e\u7f16\u8f91\u5c5e\u6027"
      },
      {
        "command": "svnWorkbench.openCleanup",
        "title": "SVN\uff1a\u6e05\u7406\u5de5\u4f5c\u526f\u672c"
      },
      {
        "command": "svnWorkbench.openRepositoryBrowser",
        "title": "SVN\uff1a\u6d4f\u89c8\u4ed3\u5e93"
      },
      {
        "command": "svnWorkbench.createBranch",
        "title": "SVN\uff1a\u521b\u5efa\u5206\u652f"
      },
      {
        "command": "svnWorkbench.createTag",
        "title": "SVN\uff1a\u521b\u5efa\u6807\u7b7e"
      },
      {
        "command": "svnWorkbench.switchWorkingCopy",
        "title": "SVN\uff1a\u5207\u6362\u5de5\u4f5c\u526f\u672c"
      },
      {
        "command": "svnWorkbench.relocateWorkingCopy",
        "title": "SVN\uff1a\u91cd\u5b9a\u4f4d\u4ed3\u5e93\u5730\u5740"
      },
      {
        "command": "svnWorkbench.mergeToWorkingCopy",
        "title": "SVN\uff1a\u5408\u5e76\u5230\u5de5\u4f5c\u526f\u672c"
      },
      {
        "command": "svnWorkbench.openPatchShelf",
        "title": "SVN\uff1a\u8865\u4e01\u4e0e\u672c\u5730\u6401\u7f6e"
      },
      {
        "command": "svnWorkbench.openReleaseNotes",
        "title": "SVN\uff1a\u751f\u6210\u53d1\u5e03\u8bf4\u660e"
      },
      {
        "command": "svnWorkbench.commitFolder",
        "title": "SVN\uff1a\u63d0\u4ea4\u5f53\u524d\u8303\u56f4"
      },
      {
        "command": "svnWorkbench.openConflictCenter",
        "title": "SVN\uff1a\u6253\u5f00\u51b2\u7a81\u4e2d\u5fc3"
      },
      {
        "command": "svnWorkbench.openDiff",
        "title": "SVN\uff1a\u6253\u5f00\u5dee\u5f02\u5bf9\u6bd4"
      },
      {
        "command": "svnWorkbench.openHistory",
        "title": "SVN\uff1a\u67e5\u770b\u5386\u53f2"
      },
      {
        "command": "svnWorkbench.openTeamConfig",
        "title": "SVN\uff1a\u6253\u5f00\u56e2\u961f\u914d\u7f6e"
      },
      {
        "command": "svnWorkbench.configureTeamConfig",
        "title": "SVN\uff1a\u914d\u7f6e\u56e2\u961f\u89c4\u5219"
      },
      {
        "command": "svnWorkbench.showOutput",
        "title": "SVN\uff1a\u663e\u793a\u8f93\u51fa"
      },
      {
        "command": "svnWorkbench.aiConfigure",
        "title": "SVN\uff1aAI \u914d\u7f6e\u6a21\u578b"
      },
      {
        "command": "svnWorkbench.aiTestConnection",
        "title": "SVN\uff1aAI \u6d4b\u8bd5\u8fde\u63a5"
      },
      {
        "command": "svnWorkbench.aiSelectScope",
        "title": "SVN\uff1a\u672c\u5730\u53d8\u66f4\u68c0\u67e5\u5f53\u524d\u8303\u56f4"
      },
      {
        "command": "svnWorkbench.aiReviewScope",
        "title": "SVN\uff1a\u672c\u5730\u53d8\u66f4\u68c0\u67e5"
      },
      {
        "command": "svnWorkbench.analyzeImpact",
        "title": "SVN\uff1a\u5206\u6790\u5f71\u54cd\u4e0e\u6d4b\u8bd5\u5efa\u8bae"
      },
      {
        "command": "svnWorkbench.openChangelists",
        "title": "SVN\uff1a\u53d8\u66f4\u96c6\u7ba1\u7406"
      },
      {
        "command": "svnWorkbench.openAgent",
        "title": "SVN\uff1a\u672c\u5730\u68c0\u67e5\u6d41\u6c34\u7ebf"
      },
      {
        "command": "svnWorkbench.openAcceptanceChecklist",
        "title": "SVN\uff1a\u6253\u5f00\u9a8c\u6536\u6e05\u5355"
      },
      {
        "command": "svnWorkbench.openProjects",
        "title": "SVN\uff1a\u9879\u76ee\u603b\u89c8"
      },
      {
        "command": "svnWorkbench.scmRefresh",
        "title": "SVN\uff1a\u5237\u65b0\u6240\u6709\u5de5\u4f5c\u526f\u672c",
        "icon": "$(refresh)"
      },
      {
        "command": "svnWorkbench.add",
        "title": "SVN\uff1a\u52a0\u5165\u7248\u672c\u63a7\u5236\uff08\u5148\u9884\u89c8\uff09"
      },
      {
        "command": "svnWorkbench.ignore",
        "title": "SVN\uff1a\u6dfb\u52a0\u5230\u5ffd\u7565\u5217\u8868\uff08\u5148\u9884\u89c8\uff09"
      },
      {
        "command": "svnWorkbench.revert",
        "title": "SVN\uff1a\u8fd8\u539f\u672c\u5730\u4fee\u6539\uff08\u5148\u9884\u89c8\uff09"
      },
      {
        "command": "svnWorkbench.lock",
        "title": "SVN\uff1a\u9501\u5b9a\u6587\u4ef6\uff08\u5148\u9884\u89c8\uff09"
      },
      {
        "command": "svnWorkbench.unlock",
        "title": "SVN\uff1a\u89e3\u9501\u6587\u4ef6\uff08\u5148\u9884\u89c8\uff09"
      }
    ],
    "submenus": [
      {
        "id": "svnWorkbench.explorer",
        "label": "SVN \u5de5\u4f5c\u53f0"
      },
      {
        "id": "svnWorkbench.ai",
        "label": "AI \u52a9\u624b"
      },
      {
        "id": "svnWorkbench.recovery",
        "label": "\u51b2\u7a81\u4e0e\u6062\u590d"
      },
      {
        "id": "svnWorkbench.repository",
        "label": "\u66f4\u591a SVN \u64cd\u4f5c"
      },
      {
        "id": "svnWorkbench.settings",
        "label": "\u8bbe\u7f6e\u4e0e\u8bca\u65ad"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "svnWorkbench.explorer",
          "group": "navigation@50",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "submenu": "svnWorkbench.explorer",
          "group": "navigation@50",
          "when": "resourceScheme == file"
        }
      ],
      "svnWorkbench.explorer": [
        {
          "command": "svnWorkbench.openWorkbench",
          "group": "1_core@1"
        },
        {
          "command": "svnWorkbench.commitFolder",
          "group": "1_core@2"
        },
        {
          "command": "svnWorkbench.updateScope",
          "group": "1_core@3"
        },
        {
          "command": "svnWorkbench.openDiff",
          "group": "1_core@4",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "svnWorkbench.openHistory",
          "group": "1_core@5"
        },
        {
          "submenu": "svnWorkbench.ai",
          "group": "2_modules@1"
        },
        {
          "submenu": "svnWorkbench.recovery",
          "group": "2_modules@2"
        },
        {
          "submenu": "svnWorkbench.repository",
          "group": "2_modules@3"
        },
        {
          "submenu": "svnWorkbench.settings",
          "group": "3_config@1"
        }
      ],
      "svnWorkbench.ai": [
        {
          "command": "svnWorkbench.aiReviewScope",
          "group": "1_ai@1"
        },
        {
          "command": "svnWorkbench.analyzeImpact",
          "group": "1_ai@2"
        },
        {
          "command": "svnWorkbench.openChangelists",
          "group": "1_ai@3"
        },
        {
          "command": "svnWorkbench.openAgent",
          "group": "1_ai@4"
        }
      ],
      "svnWorkbench.recovery": [
        {
          "command": "svnWorkbench.openConflictCenter",
          "group": "1_recovery@1"
        },
        {
          "command": "svnWorkbench.openCleanup",
          "group": "1_recovery@2",
          "when": "explorerResourceIsFolder"
        }
      ],
      "svnWorkbench.repository": [
        {
          "command": "svnWorkbench.openProperties",
          "group": "1_repository@1"
        },
        {
          "command": "svnWorkbench.openRepositoryBrowser",
          "group": "1_repository@2"
        },
        {
          "command": "svnWorkbench.createBranch",
          "group": "2_advanced@1"
        },
        {
          "command": "svnWorkbench.createTag",
          "group": "2_advanced@2"
        },
        {
          "command": "svnWorkbench.switchWorkingCopy",
          "group": "2_advanced@3"
        },
        {
          "command": "svnWorkbench.relocateWorkingCopy",
          "group": "2_advanced@4"
        },
        {
          "command": "svnWorkbench.mergeToWorkingCopy",
          "group": "2_advanced@5"
        },
        {
          "command": "svnWorkbench.openPatchShelf",
          "group": "3_tools@1"
        },
        {
          "command": "svnWorkbench.openReleaseNotes",
          "group": "3_tools@2"
        }
      ],
      "svnWorkbench.settings": [
        {
          "command": "svnWorkbench.checkEnvironment",
          "group": "1_settings@1"
        },
        {
          "command": "svnWorkbench.configureTeamConfig",
          "group": "1_settings@2"
        },
        {
          "command": "svnWorkbench.aiConfigure",
          "group": "1_settings@3"
        }
      ],
      "scm/title": [
        {
          "command": "svnWorkbench.scmRefresh",
          "group": "navigation@1",
          "when": "scmProvider == svnWorkbench"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "svnWorkbench.openConflictCenter",
          "group": "1_svn@1",
          "when": "scmResourceState == svnWorkbench.conflicted"
        },
        {
          "command": "svnWorkbench.add",
          "group": "1_svn@1",
          "when": "scmResourceState == svnWorkbench.unversioned"
        },
        {
          "command": "svnWorkbench.ignore",
          "group": "1_svn@2",
          "when": "scmResourceState == svnWorkbench.unversioned"
        },
        {
          "command": "svnWorkbench.openDiff",
          "group": "1_svn@1",
          "when": "scmResourceState == svnWorkbench.versioned"
        },
        {
          "command": "svnWorkbench.revert",
          "group": "1_svn@2",
          "when": "scmResourceState == svnWorkbench.versioned"
        },
        {
          "command": "svnWorkbench.openHistory",
          "group": "2_svn@1",
          "when": "scmProvider == svnWorkbench"
        },
        {
          "command": "svnWorkbench.lock",
          "group": "2_svn@2",
          "when": "scmResourceState == svnWorkbench.versioned"
        },
        {
          "command": "svnWorkbench.unlock",
          "group": "2_svn@3",
          "when": "scmResourceState == svnWorkbench.versioned"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run build",
    "compile:extension": "node scripts/clean-extension-build.js && node node_modules/typescript/bin/tsc -p ./",
    "build:webview": "vite build --config src/webview/vite.config.mts",
    "build": "npm run compile:extension && npm run build:webview",
    "watch": "node node_modules/typescript/bin/tsc -p ./ --watch",
    "dev:webview": "vite --config src/webview/vite.config.mts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.js\" \"docs/current/**/*.md\" \"docs/releases/**/*.md\" \"*.{json,md,mjs,mts,ts}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.js\" \"docs/current/**/*.md\" \"docs/releases/**/*.md\" \"*.{json,md,mjs,mts,ts}\" \".github/**/*.{yml,yaml}\"",
    "check:webview": "svelte-check --tsconfig ./src/webview/tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run compile:extension && npm run check:webview",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:windows-contracts": "vitest run --config vitest.config.mts tests/unit/windowsPlatformContracts.test.ts tests/unit/dualPlatformPathContracts.test.ts tests/unit/pathIdentityBoundary.test.ts tests/unit/extensionHostTempCleanup.test.ts tests/unit/githubWorkflow.test.ts",
    "test:platform-contracts": "vitest run --config vitest.config.mts tests/unit/windowsPlatformContracts.test.ts tests/unit/dualPlatformPathContracts.test.ts tests/unit/pathIdentityBoundary.test.ts tests/unit/extensionHostTempCleanup.test.ts tests/unit/githubWorkflow.test.ts",
    "test:coverage": "node scripts/run-vitest-coverage.js",
    "pretest:webview": "npm run build:webview",
    "test:webview": "node scripts/run-webview-tests.js",
    "test:performance": "npm run build:webview && node scripts/measure-webview-performance.js",
    "test:extension": "npm run build && node scripts/run-extension-tests.js",
    "docs:verify": "node scripts/verify-docs.js",
    "audit:dependencies": "npm audit --audit-level=high",
    "evidence:release": "node scripts/run-release-evidence.js",
    "verify": "npm run docs:verify && npm run audit:dependencies && npm run check && npm run test:platform-contracts && npm run test:coverage && npm run test:webview && npm run test:performance && npm run test:extension",
    "package:vsix": "npm run build && vsce package",
    "validate:vsix-install": "node scripts/validate-vsix-install.js",
    "prepare:manual-test-env": "node scripts/create-manual-acceptance-env.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "1.92.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "bits-ui": "^2.18.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.4",
    "@pierre/theme": "^2.0.0",
    "picomatch": "^4.0.5"
